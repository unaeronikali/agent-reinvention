# NorthStar Retail Digital Twin — credential template (tracked in git).
# Copy to .env and fill in real values:  cp .env.example .env
# .env itself is git-ignored so secrets never get committed.
# Variable names follow the shared Reinvention Garage standard.

# ── Azure AI Foundry (AF) Agents ──────────────────────────────────────────────
# Auth is keyless Azure AD — run `az login` first (DefaultAzureCredential). No API key.
FOUNDRY_ENDPOINT=https://af-reinvention-garage.services.ai.azure.com/api/projects/af-reinvention-garage-proj-default             # https://<resource>.services.ai.azure.com/api/projects/<name>
FOUNDRY_API_VERSION=2024-12-01-preview   # optional

# One agent/assistant id per AF agent (author each from af-agents/*.md in the Foundry portal)
ORCHESTRATOR_AGENT=Group6OrchestratorAgent
DETECT_AGENT=Group6DetectAgent
ANALYZE_AGENT=Group6Analyze
RCA_AGENT=Group6RCAAgent
SUGGEST_AGENT=Group6SuggestAgent
FIX_AGENT=Group6FixAgent
TICKET_AGENT=Group6TicketAgent

# ── ServiceNow PDI ────────────────────────────────────────────────────────────
SN_INSTANCE=https://dev405595.service-now.com                   # https://dev123456.service-now.com  (no trailing slash)
SN_USER=admin
SN_PASSWORD=Reinvention2026!
SN_TICKET_TABLE=incident      # optional; defaults to "incident"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=http://localhost:5173
